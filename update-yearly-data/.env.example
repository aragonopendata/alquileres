DATABASE_URL=postgresql://user:password@host:5432/dbname

# Usage:
#   docker build -t update-yearly-data .
#   docker run --rm -e DATABASE_URL="$DATABASE_URL" update-yearly-data 2025
#
# To reuse an already-downloaded CSV (mount it into the container):
#   docker run --rm -e DATABASE_URL="$DATABASE_URL" \
#     -v "$(pwd)/fianzapos_2025.csv:/app/fianzapos_2025.csv" \
#     update-yearly-data 2025 --skip-download
