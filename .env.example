# ============================================================================
# AOD FIANZAS - DOCKER ENVIRONMENT CONFIGURATION EXAMPLE
# ============================================================================
# Copy this file to .env and adjust values for your deployment environment.

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================
# Options: local, des, pre, pro
#
# Each environment uses different endpoints:
# - local: Local development (uses production IGEAR, no VPN required)
# - des:   Desarrollo (uses idearagondes.aragon.es, requires VPN)
# - pre:   Preproduction (uses preidearagon.aragon.es, requires VPN)
# - pro:   Production (uses idearagon.aragon.es)

ENVIRONMENT=pro

# ============================================================================
# DATA MANAGEMENT
# ============================================================================
# Configuration for JSON data volume and automatic refresh

# Path to data directory (Docker volume mount point)
DATA_PATH=/app/data

# Number of days before data is considered stale and refreshed
# Data is automatically re-downloaded when older than this value
DATA_REFRESH_DAYS=30

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# Redis is used for caching IGEAR API responses to improve performance

# Redis host (use container name for Docker networking)
REDIS_HOST=aod-fianzas-redis

# Redis port
REDIS_PORT=6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis database number
REDIS_DB=0

# Enable/disable Redis caching
REDIS_ENABLED=true

# ============================================================================
# IGEAR SERVICE TIMEOUTS
# ============================================================================
# Timeouts for external IGEAR platform API calls (in seconds)

# Total request timeout (includes connection, read, write)
IGEAR_REQUEST_TIMEOUT=180

# Connection timeout (time to establish connection)
IGEAR_CONNECTION_TIMEOUT=30

# Read timeout (time to read response data)
IGEAR_READ_TIMEOUT=120

# Write timeout (time to write request data)
IGEAR_WRITE_TIMEOUT=30

# ============================================================================
# CORS CONFIGURATION (OPTIONAL OVERRIDE)
# ============================================================================
# The backend automatically sets CORS origins based on ENVIRONMENT.
# Use this override only if you need custom CORS origins.
#
# Example: CORS_ORIGINS_OVERRIDE=http://localhost:4200,http://localhost:4201
# CORS_ORIGINS_OVERRIDE=

# ============================================================================
# LOGGING
# ============================================================================
# Log level for backend application
LOG_LEVEL=INFO

# ============================================================================
# DOCKER COMPOSE CONFIGURATION
# ============================================================================
# These settings control exposed ports

# Frontend exposed port (adjust to avoid conflicts)
FRONTEND_PORT=4201

# Backend exposed port (adjust to avoid conflicts)
BACKEND_PORT=4202

# Redis exposed port (adjust to avoid conflicts)
REDIS_PORT_EXTERNAL=6379
