# AOD Fianzas Backend - Environment Configuration Example
# Copy this file to .env and adjust values for your environment

# ============================================================================
# ENVIRONMENT CONFIGURATION
# ============================================================================

# Environment: local, des, pre, pro
# This setting controls which IGEAR domain and CORS origins are used.
#
# - local (Local Development):
#   * IGEAR Domain: idearagon.aragon.es (production, no VPN required)
#   * CORS Origins: http://localhost:4200, http://localhost:4201, http://localhost:4202
#   * Use for: Local development without VPN access
#
# - des (Desarrollo):
#   * IGEAR Domain: idearagondes.aragon.es (requires VPN)
#   * CORS Origins: https://desopendata.aragon.es
#   * Use for: Remote development environment
#
# - pre (Preproduction):
#   * IGEAR Domain: preidearagon.aragon.es (requires VPN)
#   * CORS Origins: https://preopendata.aragon.es
#   * Use for: Preproduction testing environment
#
# - pro (Production):
#   * IGEAR Domain: idearagon.aragon.es
#   * CORS Origins: https://opendata.aragon.es
#   * Use for: Production deployment
#
ENVIRONMENT=local

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Controls the verbosity of application logs
LOG_LEVEL=INFO

# CORS Origins Override (optional)
# Comma-separated list of allowed CORS origins
# If set, this overrides the environment-based default CORS origins
# Useful for custom setups or testing with non-standard frontend URLs
#
# Examples:
# CORS_ORIGINS_OVERRIDE=http://localhost:4200,http://localhost:4201
# CORS_ORIGINS_OVERRIDE=https://custom-domain.aragon.es
#
# CORS_ORIGINS_OVERRIDE=

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Redis host (use 'localhost' for local development, 'aod-fianzas-redis' for Docker)
REDIS_HOST=localhost

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis password (leave empty if no password)
REDIS_PASSWORD=

# Redis database number (default: 0)
REDIS_DB=0

# Enable/disable Redis caching (true/false)
REDIS_ENABLED=true

# ============================================================================
# IGEAR SERVICE TIMEOUTS
# ============================================================================

# Total request timeout in seconds (includes connection, read, write)
# Recommended: 180 seconds (3 minutes) for large geographic queries
IGEAR_REQUEST_TIMEOUT=180

# Connection timeout in seconds (time to establish connection)
# Recommended: 30 seconds
IGEAR_CONNECTION_TIMEOUT=30

# Read timeout in seconds (time to read response data)
# Recommended: 120 seconds (2 minutes) for large WFS responses
IGEAR_READ_TIMEOUT=120

# Write timeout in seconds (time to write request data)
# Recommended: 30 seconds
IGEAR_WRITE_TIMEOUT=30

# ============================================================================
# CACHE CONFIGURATION (TTL in seconds)
# ============================================================================

# Default cache TTL (1 month = 2592000 seconds)
# CACHE_DEFAULT_TTL=2592000

# Postal code cache TTL (1 month = 2592000 seconds)
# CACHE_CP_TTL=2592000

# Municipality cache TTL (1 month = 2592000 seconds)
# CACHE_LOCALIDAD_TTL=2592000

# Street cache TTL (1 month = 2592000 seconds)
# CACHE_CALLE_TTL=2592000

# Cache key prefix (for namespacing)
# CACHE_KEY_PREFIX=geo_search

# Cache version (for cache invalidation)
# CACHE_VERSION=v1

# ============================================================================
# LOGGING
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
